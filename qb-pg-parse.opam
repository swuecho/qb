# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Postgres's own parser for qb: check SQL, import schemas, generate tables and typed queries"
description:
  "Binds libpg_query, the parser extracted from Postgres, to check SQL, read CREATE TABLE and ALTER TABLE migrations into a schema, and generate qb table modules from it. Needs libpg_query installed (e.g. brew install libpg_query); set LIBPG_QUERY_PREFIX if it is somewhere unusual."
maintainer: ["Hao Wu"]
authors: ["Hao Wu"]
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "dune-configurator"
  "angstrom" {>= "0.14"}
  "yojson" {>= "2.0"}
  "cmdliner" {>= "1.1"}
  "qb" {with-test & = version}
  "caqti-driver-sqlite3" {with-test}
  "caqti-driver-postgresql" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
