CLI behaviour for qb-migrate (offline commands and error handling).

`new` creates the migrations directory if it does not exist yet and numbers
files sequentially.

  $ qb-migrate new init
  migrations/001_init.sql
  $ qb-migrate new add_users
  migrations/002_add_users.sql
  $ cat migrations/001_init.sql
  -- init

Invalid migration names are rejected.

  $ qb-migrate new "bad name!"
  qb-migrate: a migration's name is letters, digits, _ and -
  [1]

`embed` emits an OCaml list of migrations, either to stdout or `-o FILE`.

  $ printf 'CREATE TABLE users (id BIGSERIAL PRIMARY KEY);' > migrations/001_init.sql
  $ printf 'CREATE TABLE posts (id BIGSERIAL PRIMARY KEY);' > migrations/002_add_users.sql
  $ qb-migrate embed -m migrations
  (* Generated by qb-migrate embed. Do not edit. *)
  
  let migrations : Qb_migrate.migration list =
    [
      { name = "001_init.sql"; sql = {sql|CREATE TABLE users (id BIGSERIAL PRIMARY KEY);|sql} };
      { name = "002_add_users.sql"; sql = {sql|CREATE TABLE posts (id BIGSERIAL PRIMARY KEY);|sql} };
    ]

  $ qb-migrate embed -m migrations -o embedded.ml
  $ grep -c 'Qb_migrate.migration list' embedded.ml
  1

Commands that need a database fail cleanly when neither --db nor DATABASE_URL
is set.

  $ env -u DATABASE_URL qb-migrate status
  qb-migrate: no database: give --db URL, or set DATABASE_URL
  [1]
  $ env -u DATABASE_URL qb-migrate status --check
  qb-migrate: no database: give --db URL, or set DATABASE_URL
  [1]
  $ env -u DATABASE_URL qb-migrate up --dry-run
  qb-migrate: no database: give --db URL, or set DATABASE_URL
  [1]
  $ qb-migrate up --help=plain | grep -q -- '--dry-run'
  $ qb-migrate status --help=plain | grep -q -- '--check'
