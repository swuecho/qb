# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Run qb queries on Caqti_lwt connections"
description:
  "Qb_lwt runs the same typed queries and changesets on Caqti_lwt connections, such as the ones Dream.sql hands out."
maintainer: ["Hao Wu"]
authors: ["Hao Wu"]
license: "MIT"
tags: ["database" "sql" "caqti" "lwt"]
homepage: "https://github.com/swuecho/qb"
bug-reports: "https://github.com/swuecho/qb/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "qb" {= version}
  "caqti" {>= "2.3" & < "3.0"}
  "caqti-lwt" {>= "2.3" & < "3.0"}
  "lwt"
  "caqti-driver-sqlite3" {with-test}
  "caqti-driver-postgresql" {with-test}
  "uri" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/swuecho/qb.git"
