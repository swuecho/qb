# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A typed, Drizzle-style query builder for single-table CRUD on Caqti"
description:
  "Define a table once - a record type, one column per field - and get typed select, insert, update, delete and CREATE TABLE. Every column and condition carries its row type, so a column of one table cannot be used in a query on another."
maintainer: ["Hao Wu"]
authors: ["Hao Wu"]
license: "MIT"
tags: [
  "database" "sql" "query-builder" "caqti" "postgresql" "sqlite" "mysql"
]
homepage: "https://github.com/swuecho/qb"
bug-reports: "https://github.com/swuecho/qb/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "angstrom" {>= "0.14"}
  "caqti" {>= "2.3" & < "3.0"}
  "logs"
  "mtime" {>= "2.0"}
  "ptime"
  "uri"
  "caqti-driver-sqlite3" {with-test}
  "caqti-driver-postgresql" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/swuecho/qb.git"
