# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Apply the migrations qb is typed from to a Postgres database"
description:
  "Runs migrations/*.sql in order, each once and in a transaction, records them in a qb_migrations table, and checks that the database matches the schema [%sql] was compiled against. A library to call when a program starts, and the qb-migrate command."
maintainer: ["Hao Wu"]
authors: ["Hao Wu"]
license: "MIT"
tags: ["database" "migrations" "postgresql"]
homepage: "https://github.com/swuecho/qb"
bug-reports: "https://github.com/swuecho/qb/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "qb-pg-parse" {= version}
  "caqti" {>= "2.3" & < "3.0"}
  "caqti-driver-postgresql" {>= "2.3" & < "3.0"}
  "ptime"
  "uri"
  "cmdliner" {>= "1.1"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/swuecho/qb.git"
